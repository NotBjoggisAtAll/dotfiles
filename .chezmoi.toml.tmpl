{{- $is_desktop := false -}}

{{- if eq .chezmoi.os "linux" -}}
{{-   if or (stat "/usr/bin/Xorg") (stat "/usr/bin/wayland-scanner") (lookPath "xrandr") -}}
{{-     $is_desktop = true -}}
{{-   end -}}
{{- else if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
{{-   $is_desktop = true -}}
{{- end -}}

[data]
    is_desktop = {{ $is_desktop }}
